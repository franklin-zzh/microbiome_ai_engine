# ==============================================================================
# agent_cs 生产环境变量模板 (.env.prod)
# 
# 部署说明：
# 1. 在服务器部署目录复制本文件为 .env.prod: cp .env.prod.example .env.prod
# 2. 根据实际云端环境填入真实凭据（切勿使用默认弱密码）
# ==============================================================================

APP_NAME=agent_cs
DEBUG=false
SQLALCHEMY_ECHO=false

# ============ 1. MySQL 8 数据库（通过 fmtsw-net 内部网络直接访问 mysql8 容器）============
# 统一单库 mb_ai_engine，字符集 utf8mb4。表结构由 Alembic 自动迁移维护
# 注意：密码里的 '+' 特殊字符已转义为 '%2B'
DATABASE_URL=mysql+pymysql://root:qK5_vD2.hY8%2BmX3d@mysql8:3306/mb_ai_engine?charset=utf8mb4

# ============ 2. Redis 7 缓存（通过 fmtsw-net 内部网络直接访问 redis 容器）============
# agent_cs 项目独占 Redis db3
REDIS_URL=redis://:qK5_vD2.hY8%2BmX3d@redis:6379/3
REDIS_PASSWORD=qK5_vD2.hY8+mX3d
SESSION_TTL_SECONDS=1800
SESSION_RETENTION_DAYS=30
NEGATIVE_STREAK_THRESHOLD=2

# ============ 3. Dify 联动配置（本地 Dify 穿透或局域网访问地址）============
# 如果本地 Dify 通过 frp 穿透至公网域名，例如 https://dify-api.fmtcloud.cn/v1
DIFY_BASE_URL=https://dify-api.fmtcloud.cn/v1
DIFY_API_KEY=your-dify-api-key
DIFY_CHAT_API_KEY=your-dify-chat-api-key
DIFY_KNOWLEDGE_API_KEY=your-dify-knowledge-api-key
CS_QA_DATASET_ID=your-cs-qa-dataset-id
CS_DOC_DATASET_ID=
SALES_DATASET_ID=
DOCTOR_DATASET_ID=

# ============ 4. 企业微信 和 微信客服 (WXKF) 接入配置 (企业微信管理后台获取) ============
WXKF_CORP_ID=wwbd7150f807b4472f
WXKF_SECRET=your_wxkf_secret_here
WXKF_TOKEN=your_wxkf_token_here
WXKF_ENCODING_AES_KEY=your_43_character_aes_key_here

# ============ 5. 安全基线（P0 必填项，缺失则后端拒绝启动）============
# JWT 密钥：生成命令 python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-random-48-chars-jwt-secret-here
JWT_EXPIRE_MINUTES=720

# 管理后台管理员账号密码（用于 /admin 及登录接口 /api/v1/auth/login）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-super-strong-admin-password

# 内部接口通信密钥 (Dify workflow 回调 / 内部异步服务，Header: X-API-Key)
# 生成命令 python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=your-random-32-chars-internal-key

# CORS 白名单（逗号分隔；必须填入线上真实域名，禁止 *）
CORS_ORIGINS=https://wx.fmtcloud.cn
