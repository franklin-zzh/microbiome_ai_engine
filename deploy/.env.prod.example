# ==============================================================================
# 生产环境环境变量配置文件模板 (.env.prod)
# 复制为 .env.prod 并填入真实凭据
# ==============================================================================

APP_NAME=agent_cs
DEBUG=false
SQLALCHEMY_ECHO=false

# ==================== MySQL 生产数据库 ====================
DATABASE_URL=mysql+pymysql://fmt:fmt_secret_2026@global-mysql8:3306/mb_ai_engine?charset=utf8mb4

# ==================== Redis 生产实例 (独占 db3) ====================
REDIS_URL=redis://global-redis:6379/3
SESSION_TTL_SECONDS=1800
SESSION_RETENTION_DAYS=30
NEGATIVE_STREAK_THRESHOLD=2

# ==================== Dify 知识库与 Agent 工作流配置 ====================
DIFY_BASE_URL=http://192.168.110.16:3080/v1
DIFY_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
DIFY_CHAT_API_KEY=
DIFY_SALES_CHAT_API_KEY=
DIFY_PARTNER_CHAT_API_KEY=
DIFY_CHAT_TIMEOUT_SECONDS=120

CS_QA_DATASET_ID=
CS_DOC_DATASET_ID=
SALES_DATASET_ID=
DOCTOR_DATASET_ID=

CS_PIPELINE_FILE_NODE_ID=
CS_PIPELINE_VERSION=default
DIFY_PIPELINE_TIMEOUT_SECONDS=600
CS_SCORE_THRESHOLD=0.65

# 预设话术（留空使用系统内置默认话术）
RISK_BLOCKED_REPLY=
WXKF_ACK_REPLY=
WXKF_WELCOME_REPLY=

# ==================== 微信客服配置 (1对1 客服会话) ====================
WXKF_CORP_ID=
WXKF_SECRET=
WXKF_TOKEN=
WXKF_ENCODING_AES_KEY=

# ==================== 企业微信招商群 / 招商自建应用 / Webhook 配置 ====================
WECOM_SALES_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=9c0f4b81-a47e-468e-ada7-0ab5e6ffc7db
WECOM_SALES_CORP_ID=
WECOM_SALES_AGENT_ID=
WECOM_SALES_SECRET=
WECOM_SALES_TOKEN=
WECOM_SALES_ENCODING_AES_KEY=

# ==================== 企业微信智能机器人 (API 模式 / WebSocket 长连接) ====================
# 是否启用智能机器人 WebSocket 长连接 Worker（true / false）
WECOM_AIBOT_ENABLED=false
# 企微智能机器人 Bot ID
WECOM_AIBOT_ID=
# 企微智能机器人 Secret
WECOM_AIBOT_SECRET=
# 企微智能机器人 WebSocket 接入地址（默认 wss://openws.work.weixin.qq.com）
WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com

# ==================== 安全基线 (P0 必填) ====================
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

INTERNAL_API_KEY=

CORS_ORIGINS=https://wx.fmtcloud.cn
