# ==============================================================================
# 富玛特 AI 智能引擎 (microbiome_ai_engine) 环境变量配置模板
# 使用说明：复制本文件为项目根目录的 .env 并填入真实凭据与配置
# 命令示例：copy .env.example .env (Windows CMD) 或 cp .env.example .env (Linux/Bash)
# ==============================================================================

APP_NAME=agent_cs
DEBUG=false
# SQLAlchemy 是否打印 SQL 语句（排障用）。默认 false
SQLALCHEMY_ECHO=false

# ==================== MySQL 数据库配置 (单库 mb_ai_engine) ====================
DATABASE_URL=mysql+pymysql://fmt:fmt_secret_2026@127.0.0.1:3306/mb_ai_engine?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://fmt:fmt_secret_2026@127.0.0.1:3306/mb_ai_engine_test?charset=utf8mb4

# ==================== Redis 配置 (独占 db3) ====================
REDIS_URL=redis://127.0.0.1:6380/3
SESSION_TTL_SECONDS=1800
SESSION_RETENTION_DAYS=30
NEGATIVE_STREAK_THRESHOLD=2

# ==================== Dify 知识库与 Agent 工作流配置 ====================
DIFY_BASE_URL=http://192.168.110.16:3080/v1
# 默认 Dify API Key
DIFY_API_KEY=
# 知识库管理专用 API Key (Dataset / Pipeline 写入端)
DIFY_KNOWLEDGE_API_KEY=
# 客服 Agent 对话 API Key (微信客服 1v1 对话用)
DIFY_CHAT_API_KEY=
# 招商/销售赋能 Agent 专属对话 API Key (1v1 销售实战话术用，留空则回退 DIFY_CHAT_API_KEY)
DIFY_SALES_CHAT_API_KEY=
# 商务招商与战略合伙 Agent 专属对话 API Key (企业群 / 投资商 / 赞助合作群用，留空则回退 DIFY_SALES_CHAT_API_KEY)
DIFY_PARTNER_CHAT_API_KEY=
DIFY_CHAT_TIMEOUT_SECONDS=120

# 知识库 Dataset ID 映射
CS_QA_DATASET_ID=
CS_DOC_DATASET_ID=
SALES_DATASET_ID=
DOCTOR_DATASET_ID=

# Knowledge Pipeline 配置
CS_PIPELINE_FILE_NODE_ID=
CS_PIPELINE_VERSION=default
DIFY_PIPELINE_TIMEOUT_SECONDS=600
CS_SCORE_THRESHOLD=0.65

# 预设话术配置（留空使用系统内置默认话术）
RISK_BLOCKED_REPLY=
WXKF_ACK_REPLY=
WXKF_WELCOME_REPLY=

# ==================== 微信客服配置 (1对1 客服会话) ====================
WXKF_CORP_ID=
WXKF_SECRET=
WXKF_TOKEN=
WXKF_ENCODING_AES_KEY=

# ==================== 企业微信招商群 / 招商自建应用 / Webhook 配置 ====================
# 企微群机器人 Webhook 地址（用于商机线索卡片通知与招商宣传模版卡片推送）
WECOM_SALES_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=9c0f4b81-a47e-468e-ada7-0ab5e6ffc7db

# 招商自建应用配置（用于接收外部群 @ 机器人消息回调并自动回复，留空则回退 WXKF 配置）
WECOM_SALES_CORP_ID=
WECOM_SALES_AGENT_ID=
WECOM_SALES_SECRET=
WECOM_SALES_TOKEN=
WECOM_SALES_ENCODING_AES_KEY=

# ==================== 企业微信智能机器人 (API 模式 / WebSocket 长连接) ====================
# 是否启用智能机器人 WebSocket 长连接 Worker（true / false）
WECOM_AIBOT_ENABLED=false
# 企微智能机器人 Bot ID
WECOM_AIBOT_ID=
# 企微智能机器人 Secret
WECOM_AIBOT_SECRET=
# 企微智能机器人 WebSocket 接入地址（默认 wss://openws.work.weixin.qq.com）
WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com

# ==================== 安全基线 (生产必填) ====================
# JWT 签名密钥（生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"，长度需 >= 32 字符）
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# 管理后台账号与密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 内部异步链路 / Dify 回调共享鉴权 Key (Header: X-API-Key)
INTERNAL_API_KEY=

# CORS 白名单配置（逗号分隔，禁止使用通配符 *）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
