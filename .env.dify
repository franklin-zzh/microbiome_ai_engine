# ============================================================
# Dify 局域网部署环境变量模板
# 用法：
#   1. 复制本文件为 .env.dify：cp .env.dify.example .env.dify
#   2. 修改 SERVER_IP 为你的局域网服务器 IP
#   3. 生成并替换 SECRET_KEY（openssl rand -base64 42），其余密钥建议一并修改
#   4. 启动：docker compose -f docker-compose.dify.yml --env-file .env.dify up -d
# ============================================================

# === 服务器内网 IP（局域网内其他机器通过该 IP 访问 Dify）===
SERVER_IP=192.168.110.16

# === 对外端口（web 控制台 / api，其余服务仅容器内网，不映射宿主）===
WEB_PORT=3080
API_PORT=5081

# === 数据卷根目录（务必放在磁盘空间充足的分区，如 /data）===
DIFY_DATA_ROOT=/data/data2025/fmt_software/fmt-infra/dify/docker/volumes

# === 安全密钥（首次部署必须修改）===
# 生成方式：openssl rand -base64 42
SECRET_KEY=please-change-me-using-openssl-rand-base64-42

# === Redis（Dify 独占 db4，仅容器内网）===
REDIS_PASSWORD=difyai123456

# === PostgreSQL（Dify 元数据库，仅容器内网）===
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin

# === Weaviate 向量库（仅容器内网）===
WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih
WEAVIATE_API_KEY_USERS=hello@dify.ai

# === Dify Sandbox ===
SANDBOX_API_KEY=dify-sandbox

# === Plugin Daemon ===
PLUGIN_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
PLUGIN_DIFY_INNER_API_KEY=QaHbTe77CtuXmsfyhR7+vRjI/+XbV1AaFy691iy+kGDv2Jvy0/eAh8Y1

# === Dify Agent ===
DIFY_AGENT_SERVER_SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY
DIFY_AGENT_API_TOKEN=dify-agent-run-token-for-dev-only
DIFY_AGENT_SHELLCTL_AUTH_TOKEN=

# === Web 控制台地址（指向服务器 IP + API 端口，否则局域网访问会连到 localhost）===
CONSOLE_API_URL=http://${SERVER_IP}:${API_PORT}
APP_API_URL=http://${SERVER_IP}:${API_PORT}
# 容器内部通信保持服务名
SERVER_CONSOLE_API_URL=http://api:5001
NEXT_PUBLIC_SOCKET_URL=ws://${SERVER_IP}:${API_PORT}
