#  agent_cs 环境变量模板
#  复制为 .env 并填入真实值，切勿提交真实密钥到 Git

# ============ MySQL 双库（本地 Docker 部署 global-mysql8，端口 3306）============
# mb_ai_core：公共用户 / 知识库索引
CORE_DATABASE_URL=mysql+pymysql://root:fumate@localhost:3306/mb_ai_core?charset=utf8mb4
# mb_ai_cs：客服 Agent 专有库（cs_chat_logs 等）
CS_DATABASE_URL=mysql+pymysql://root:fumate@localhost:3306/mb_ai_cs?charset=utf8mb4

# 测试库
TEST_CORE_DATABASE_URL=mysql+pymysql://root:fumate@localhost:3306/mb_ai_core_test?charset=utf8mb4
TEST_CS_DATABASE_URL=mysql+pymysql://root:fumate@localhost:3306/mb_ai_cs_test?charset=utf8mb4

# ============ Redis（本地 Docker 部署，端口 6380，密码 fumate；本项目独占 db3）============
REDIS_URL=redis://:fumate@localhost:6380/3
SESSION_TTL_SECONDS=1800
NEGATIVE_STREAK_THRESHOLD=2

# ============ Dify（共享知识库引擎 engine_rag）============
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=your-dify-api-key
CS_DATASET_ID=your-cs-dataset-id
SALES_DATASET_ID=your-sales-dataset-id

# App
APP_NAME=agent_cs
DEBUG=true
