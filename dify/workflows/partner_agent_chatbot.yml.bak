      positionAbsolute:
        x: 100
        y: 400
      selected: false
      sourcePosition: null
      targetPosition: null
      type: custom
      width: 242
      zIndex: 0
    - data:
        title: 商务与战略术语归一化
        desc: 专有名词、公司品牌、战略合作与商业术语扩展
        type: code
        code_language: python3
        code: "def main(query: str = \"\") -> dict:\n    import re\n    q = query.strip() if query else \"\"\n    synonym_map = {\n        \"fmt\": \"FMT 肠道菌群移植\",\n        \"富玛特\": \"富玛特生物科技（FMT）\",\n        \"公司介绍\": \"富玛特公司背景、核心团队与发展历程\",\n        \"公众号\": \"富玛特官方微信公众号与新媒体矩阵\",\n        \"赞助\": \"战略合作、峰会赞助与品牌联名\",\n        \"投资\": \"融资历程、商业模式与战略投资机会\",\n        \"代理\": \"区域独家代理、合伙人招商政策\",\n        \"合同\": \"商务合作协议与合同模板标准框架\",\n        \"底价\": \"合作政策与阶梯采购价格机制\",\n        \"活菌量\": \"单袋/单粒活菌量 CFU 与活性锁鲜技术\",\n        \"供体\": \"严格供体筛选标准（高于行业平均标准）\",\n        \"资质\": \"医疗器械认证、三甲临床合作背书\",\n    }\n    sorted_keys = sorted(synonym_map.keys(), key=len, reverse=True)\n    patterns = []\n    for k in sorted_keys:\n        if k.isascii():\n            patterns.append(rf\"(?<![a-zA-Z]){re.escape(k)}(?![a-zA-Z])\")\n        else:\n            patterns.append(re.escape(k))\n    combined_pattern = re.compile(\"|\".join(patterns), flags=re.IGNORECASE)\n    \n    def _repl(match):\n        matched_text = match.group(0).lower()\n        return synonym_map.get(matched_text, match.group(0))\n    \n    norm_q = combined_pattern.sub(_repl, q)\n    return {\"normalized_query\": norm_q, \"original_query\": q}"
        outputs:
          normalized_query:
            type: string
            children: null
          original_query:
            type: string
            children: null
        selected: false
        variables:
        - value_selector:
          - sys
          - query
          value_type: string
          variable: query
        isInIteration: false
        isInLoop: false
        iteration_id: null
        loop_id: null
      height: 72
      id: normalize_query
      position:
        x: 420
        y: 400
      positionAbsolute:
        x: 420
        y: 400
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 242
      zIndex: 0
    - data:
        title: 商务意图与多轮改写
        desc: 结合上下文生成供招商、投资、赞助知识库检索的独立 Query
        type: llm
        version: '1'
        context:
          enabled: false
          variable_selector: []
        vision:
          enabled: false
        structured_output_enabled: false
        memory:
          query_prompt_template: '{{#sys.query#}}'
          role_prefix:
            assistant: ''
            user: ''
          window:
            enabled: true
            size: 10
        model:
          provider: langgenius/deepseek/deepseek
          name: deepseek-v4-flash
          mode: chat
          completion_params:
            max_tokens: 256
            temperature: 0.0
            thinking: false
        prompt_template:
        - edition_type: basic
          id: prompt-partner-rewriter
          role: system
          text: '# Role
            你是一个资深的商务战略与招商检索查询改写助手。你的任务是根据投资人、意向代理商或合作机构在企业群内的提问与对话上下文，生成信息完整独立的检索语句。

            # Rules
            1. 品牌与公司介绍识别：如用户询问“你们公司主要做什么”、“公众号是哪个”、“有哪些背书”，精准扩展为公司介绍、新媒体矩阵、科研资质与商业模式。
            2. 商业政策识别：如用户询问“加盟支持有哪些”、“合同怎么签”、“底价多少”，扩展为招商合伙政策、培训支持、合同框架与价格体系。
            3. 技术壁垒识别：如用户询问“活菌量多少”、“供体安全吗”，扩展为核心产品参数、活菌存活技术与严苛供体筛选标准。
            4. 输出必须且只能是一句精炼的独立查询文本，严禁包含任何多余解释。'
        - edition_type: basic
          id: prompt-partner-rewriter-user
          role: user
          text: '当前提问：{{#normalize_query.normalized_query#}}

            请输出完整独立查询语句：'
        selected: false
        isInIteration: false
        isInLoop: false
        iteration_id: null
        loop_id: null
      height: 116
      id: query_rewriter
      position:
        x: 740
        y: 400
      positionAbsolute:
        x: 740
        y: 400
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 242
      zIndex: 0
    - data:
        title: 检索词清洗
        desc: 剥除思考标签并提取最终检索 Query
        type: code
        code_language: python3
        code: "def main(llm_text: str = \"\", fallback_query: str = \"\") -> dict:\n    import re\n    text = re.sub(r\"<think>.*?</think>\", \"\", llm_text or \"\", flags=re.S).strip()\n    clean_query = text if text else (fallback_query or \"\")\n    clean_query = clean_query.strip('\"\\'“”‘’').strip()\n    return {\"search_query\": clean_query if clean_query else (fallback_query or \"\")}"
        outputs:
          search_query:
            type: string
            children: null
        selected: false
        variables:
        - value_selector:
          - query_rewriter
          - text
          value_type: string
          variable: llm_text
        - value_selector:
          - normalize_query
          - normalized_query
          value_type: string
          variable: fallback_query
        isInIteration: false
        isInLoop: false
        iteration_id: null
        loop_id: null
      height: 72
      id: extract_query
      position:
        x: 1060
        y: 400
      positionAbsolute:
        x: 1060
        y: 400
      selected: false
      sourcePosition: right
      targetPosition: left
      type: custom
      width: 242
      zIndex: 0
    - data:
        dataset_ids:
        - rrzxjFlDmXAw70eqR3XbQw1+behx6FC3Px7c/uKjk7HdAUjdFW+wLSrSDymY6Iga
        desc: 招商与商务合作 QA 问答库，top_k 3，阈值 0.45
        metadata_filtering_mode: disabled
        multiple_retrieval_config:
          reranking_enable: true
          reranking_mode: reranking_model
          reranking_model:
            model: Qwen/Qwen3-Reranker-0.6B
            provider: langgenius/siliconflow/siliconflow
          score_threshold: 0.45
          top_k: 3
          weights: null
        query_attachment_selector: []
        query_variable_selector:
        - extract_query
        - search_query
        retrieval_mode: multiple
        selected: false
        single_retrieval_config: null
        title: 检索商务 QA 库
        type: knowledge-retrieval
        isInIteration: false
        isInLoop: false
        iteration_id: null
        loop_id: null
      height: 80
      id: knowledge_retrieval_qa
      position:
        x: 1380
        y: 300
      positionAbsolute:
        x: 1380
        y: 300
      selected: false
