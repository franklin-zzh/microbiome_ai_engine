app:
  description: '富玛特（FMT）商务招商与战略合伙专属 Agent（agent_partner）：

    面向代理商、机构投资人、赞助合作方、大健康战略伙伴；

    全面介绍公司背景、公众号与品牌矩阵、技术壁垒（高活性活菌量/严苛供体筛选）、产品矩阵、商业合作模式、价格机制与合同范本框架。'
  icon: 🤝
  icon_background: '#DCFCE7'
  icon_type: emoji
  mode: advanced-chat
  name: 商务招商与战略合伙助手
  use_icon_as_answer_icon: false
dependencies:
- current_identifier: null
  type: marketplace
  value:
    marketplace_plugin_unique_identifier: langgenius/deepseek:0.0.19@1aa3c64e2f50179afe8410ad79412dab92bf5919a27da8e2b13071b5e5f8ce81
    version: null
- current_identifier: null
  type: marketplace
  value:
