        code: "def main(llm_text: str) -> dict:\n    import re\n    text = re.sub(r\"<think>.*?</think>\", \"\", llm_text or \"\", flags=re.S).strip()\n    return {\"answer\": text}"
        code_language: python3
        desc: 剥除思考标签
        isInIteration: false
        isInLoop: false
