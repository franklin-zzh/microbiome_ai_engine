    - data:
        dataset_ids:
        - Pq44sQkP0HAjufrZOiYpJjyq/ZjEtwdWzzr+B8CHIgtAUZeQCcPVC7cgBwhN4b3r
        desc: 企业资质、战略合作、产品白皮书与合同模板长文档库，top_k 5，阈值 0.3
        metadata_filtering_mode: disabled
        multiple_retrieval_config:
          reranking_enable: true
          reranking_mode: reranking_model
          reranking_model:
            model: Qwen/Qwen3-Reranker-0.6B
            provider: langgenius/siliconflow/siliconflow
          score_threshold: 0.3
          top_k: 5
          weights: null
        query_attachment_selector: []
        query_variable_selector:
        - extract_query
        - search_query
        retrieval_mode: multiple
        selected: false
        single_retrieval_config: null
        title: 检索公司与产品技术白皮书
        type: knowledge-retrieval
        isInIteration: false
        isInLoop: false
        iteration_id: null
        loop_id: null
      height: 80
      id: knowledge_retrieval_doc
      position:
        x: 1380
        y: 520
      positionAbsolute:
        x: 1380
        y: 520
      selected: false
      sourcePosition: null
      targetPosition: null
      type: custom
      width: 242
      zIndex: 0
    - data:
        code: "def main(query: str = \"\", qa_docs: list = None, doc_docs: list = None) -> dict:\n    qa_docs = qa_docs if isinstance(qa_docs, list) else []\n    doc_docs = doc_docs if isinstance(doc_docs, list) else []\n\n    def pick_score(d: dict) -> float:\n        try:\n            s = d.get(\"score\")\n            if s is None:\n                s = (d.get(\"metadata\") or {}).get(\"score\", 0.0)\n            return float(s)\n        except (ValueError, TypeError):\n            return 0.0\n\n    merged = []\n    for d in qa_docs:\n        if isinstance(d, dict):\n            content = d.get(\"content\") or d.get(\"text\") or d.get(\"title\") or \"\"\n            title = d.get(\"title\") or \"\"\n            merged.append({\"content\": content, \"title\": title, \"score\": pick_score(d), \"source\": \"PARTNER_QA\"})\n\n    for d in doc_docs:\n        if isinstance(d, dict):\n            content = d.get(\"content\") or d.get(\"text\") or d.get(\"title\") or \"\"\n            title = d.get(\"title\") or \"\"\n            merged.append({\"content\": content, \"title\": title, \"score\": pick_score(d), \"source\": \"COMPANY_DOC\"})\n\n    merged.sort(key=lambda x: x[\"score\"], reverse=True)\n    return {\"merged\": merged, \"top_score\": merged[0][\"score\"] if merged else 0.0}"
        code_language: python3
        desc: 合并商务问答与公司技术文档两路检索结果
        outputs:
          merged:
            type: array[object]
          top_score:
            children: null
            type: number
        selected: false
        title: 合并排序
        type: code
        variables:
        - value_selector:
          - extract_query
          - search_query
          variable: query
        - value_selector:
          - knowledge_retrieval_qa
          - result
          variable: qa_docs
        - value_selector:
          - knowledge_retrieval_doc
          - result
          variable: doc_docs
        isInIteration: false
        isInLoop: false
        iteration_id: null
        loop_id: null
      height: 96
      id: merge_docs
      position:
        x: 1680
        y: 400
      positionAbsolute:
        x: 1680
        y: 400
      selected: false
      sourcePosition: null
      targetPosition: null
      type: custom
      width: 242
      zIndex: 0
    - data:
        cases:
        - case_id: 'true'
          conditions:
          - comparison_operator: ≥
            value: '0.35'
            varType: number
            variable_selector:
            - merge_docs
            - top_score
          id: 'true'
          logical_operator: and
        - case_id: 'false'
          conditions:
          - comparison_operator: <
            id: cond-score-low
            value: '0.35'
            varType: number
            variable_selector:
            - merge_docs
            - top_score
          id: 'false'
          logical_operator: and
        desc: 有可用结果 -> 正常商务作答；否则 -> 转接专属招商总监
        selected: false
        title: 是否有可用结果
        type: if-else
        isInIteration: false
        isInLoop: false
        iteration_id: null
        loop_id: null
      height: 216
      id: score_branch
      position:
        x: 1980
        y: 400
      positionAbsolute:
        x: 1980
        y: 400
      selected: false
      sourcePosition: null
      targetPosition: null
      type: custom
      width: 242
      zIndex: 0
    - data:
        context:
          enabled: true
          variable_selector:
          - merge_docs
          - merged
        desc: 以资深战略商务与品牌总监口吻，进行高端、有温度、有说服力的招商与合作答疑
        model:
          completion_params:
            max_tokens: 600
